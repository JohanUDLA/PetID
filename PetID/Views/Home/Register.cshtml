@model RegisterViewModel
@{
    ViewData["Title"] = "Crear cuenta - PetID";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
</head>
<body>
    <main class="login-container">
        <div class="login-wrapper">
            <section class="login-card" aria-labelledby="register-title">
                <header class="login-header text-center">
                    <a href="/" aria-label="Volver a PetID">
                        <img src="~/imagenes/Logo_PetID.png" alt="Logo PetID" class="login-logo" />
                    </a>
                    <h1 id="register-title" class="mt-3 fw-bold">Crear cuenta</h1>
                    <p class="text-muted small">Únete a PetID y protege a tus mascotas</p>
                </header>

                <form asp-action="Register" method="post" class="login-form" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-bold"></label>
                        <input asp-for="Email" class="form-control register-input" autocomplete="email" placeholder="tu@email.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-bold"></label>
                        <input asp-for="Password" class="form-control register-input" autocomplete="new-password" placeholder="Al menos 8 caracteres" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label fw-bold"></label>
                        <input asp-for="ConfirmPassword" class="form-control register-input" autocomplete="new-password" placeholder="Repite tu contraseña" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 fw-bold">Crear mi cuenta</button>
                </form>

                <div class="text-center mt-4">
                    <p class="text-muted mb-0">¿Ya tienes una cuenta? <a asp-action="Login" class="text-primary fw-bold text-decoration-none">Inicia sesión</a></p>
                </div>
            </section>
        </div>
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
