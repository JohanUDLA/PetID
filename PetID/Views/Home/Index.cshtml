@{
    ViewData["Title"] = "PetID NFC - Identificación Inteligente para Mascotas";
}

@section Styles {
    <link rel="stylesheet" href="~/css/index.css" asp-append-version="true" />
}

<div class="hero-wrapper mb-5">
    <div class="hero-overlay d-flex align-items-center">
        <div class="container text-white py-5">
            <div class="row align-items-center">
                <div class="col-lg-7">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <img src="~/imagenes/Logo_PetID.png" asp-append-version="true" alt="PetID Logo" class="hero-logo rounded-circle shadow" />
                        <span class="badge bg-primary fs-6 px-3 py-2">Tecnología NFC</span>
                    </div>
                    <h1 class="display-3 fw-bold mb-3">PetID NFC</h1>
                    <p class="lead fs-3 fw-normal mb-4">Collares e identificadores inteligentes para la seguridad de tu mascota</p>
                    <p class="fs-5 mb-4 text-light opacity-90">
                        Una solución rápida, moderna y eficiente para localizar e identificar a tu compañero en caso de extravío. Escaneo inmediato desde cualquier smartphone sin baterías ni aplicaciones adicionales.
                    </p>
                    <div class="d-grid gap-3 d-sm-flex justify-content-sm-start">
                        <a href="#funcionamiento" class="btn btn-primary btn-lg px-4 me-sm-2 shadow-sm">¿Cómo Funciona?</a>
                        <a href="#precios" class="btn btn-outline-light btn-lg px-4">Planes y Precios</a>
                    </div>
                </div>
                <div class="col-lg-5 text-center mt-5 mt-lg-0">
                    <div class="hero-card p-4 rounded-4 shadow-lg bg-white text-dark">
                        <img src="~/imagenes/Logo_PetID.png" asp-append-version="true" alt="PetID Logo Grande" class="img-fluid rounded-4 mb-3 logo-preview" />
                        <h4 class="fw-bold mb-2">Escanea. Identifica. Protege.</h4>
                        <p class="text-muted small mb-0">Tecnología sin contacto para la tranquilidad de tu hogar.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container">
    <Funcionamiento Técnico -->
    <section id="funcionamiento" class="mb-5 pt-4">
        <div class="text-center mb-5">
            <h2 class="fw-bold display-5 text-dark">¿Cómo Funciona el Sistema?</h2>
            <p class="text-muted lead">Protección inteligente en solo 3 sencillos pasos</p>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="card custom-card h-100 shadow-sm border-0 text-center p-4">
                    <div class="card-body">
                        <div class="step-badge mb-3">1</div>
                        <h4 class="card-title fw-bold mb-3">Registro de Perfil</h4>
                        <p class="card-text text-muted">
                            Crea tu perfil y el de tu mascota con datos de contacto, foto, dirección e información médica vital como vacunas y alergias.
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card custom-card h-100 shadow-sm border-0 text-center p-4">
                    <div class="card-body">
                        <div class="step-badge mb-3">2</div>
                        <h4 class="card-title fw-bold mb-3">Medalla Inteligente</h4>
                        <p class="card-text text-muted">
                            Cada chip NFC contiene una URL única direccionada directamente al perfil de tu mascota. No requiere baterías ni descargas de apps.
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card custom-card h-100 shadow-sm border-0 text-center p-4">
                    <div class="card-body">
                        <div class="step-badge mb-3">3</div>
                        <h4 class="card-title fw-bold mb-3">Escaneo Rápido</h4>
                        <p class="card-text text-muted">
                            Si alguien encuentra a tu mascota, solo debe acercar su smartphone al collar para ver tus datos de contacto al instante.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    
</div>