@{
    ViewData["Title"] = "Dashboard - PetID";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-light bg-light border-bottom">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold" href="/">PetID</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-lg-center">
                    <li class="nav-item"><a class="nav-link" href="#identificadores">Identificadores</a></li>
                    <li class="nav-item"><a class="nav-link" href="#estadisticas">Estadísticas</a></li>
                    <li class="nav-item">
                        <form action="@Url.Action("Logout", "Home")" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="nav-link text-danger border-0 bg-transparent">Cerrar Sesión</button>
                        </form>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="container dashboard-container py-4 py-lg-5">
        <div class="alert alert-success alert-dismissible fade show" role="status">
            <strong>¡Bienvenido!</strong> Has iniciado sesión correctamente en PetID.
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>

        <section class="dashboard-heading mb-4" aria-labelledby="dashboard-title">
            <div>
                <p class="dashboard-eyebrow mb-1">TU ESPACIO PETID</p>
                <h1 id="dashboard-title" class="h2 mb-2">Resumen de tu cuenta</h1>
                <p class="text-muted mb-0">Consulta el estado de tus mascotas e identificadores.</p>
            </div>
        </section>

        <section id="mascotas" class="row g-3 mb-5" aria-label="Resumen">
            <div class="col-12 col-sm-6 col-xl-3">
                <article class="card dashboard-stat h-100">
                    <div class="card-body">
                        <div class="stat-icon stat-icon-blue" aria-hidden="true">🐾</div>
                        <p class="stat-label">Mascotas registradas</p>
                        <p class="stat-value">0</p>
                        <p class="stat-note">Tus perfiles aparecerán aquí</p>
                    </div>
                </article>
            </div>
            <div class="col-12 col-sm-6 col-xl-3">
                <article class="card dashboard-stat h-100">
                    <div class="card-body">
                        <div class="stat-icon stat-icon-green" aria-hidden="true">📱</div>
                        <p class="stat-label">Identificadores activos</p>
                        <p class="stat-value">0</p>
                        <p class="stat-note">Chips vinculados a tus mascotas</p>
                    </div>
                </article>
            </div>
            <div class="col-12 col-sm-6 col-xl-3">
                <article class="card dashboard-stat h-100">
                    <div class="card-body">
                        <div class="stat-icon stat-icon-purple" aria-hidden="true">📡</div>
                        <p class="stat-label">Escaneos este mes</p>
                        <p class="stat-value">0</p>
                        <p class="stat-note">Lecturas registradas por NFC</p>
                    </div>
                </article>
            </div>
            <div class="col-12 col-sm-6 col-xl-3">
                <article class="card dashboard-stat h-100">
                    <div class="card-body">
                        <div class="stat-icon stat-icon-orange" aria-hidden="true">🔔</div>
                        <p class="stat-label">Alertas pendientes</p>
                        <p class="stat-value">0</p>
                        <p class="stat-note">Avisos que requieren tu atención</p>
                    </div>
                </article>
            </div>
        </section>

        <section id="identificadores" class="dashboard-section mb-4" aria-labelledby="identifiers-title">
            <div class="section-heading">
                <div>
                    <p class="dashboard-eyebrow mb-1">IDENTIFICACIÓN NFC</p>
                    <h2 id="identifiers-title" class="h3 mb-1">Mis identificadores</h2>
                    <p class="text-muted mb-0">Controla los chips y su estado de vinculación.</p>
                </div>
                <span class="section-icon" aria-hidden="true">📲</span>
            </div>

            <div class="row g-3 mt-2 mb-3">
                <div class="col-12 col-md-4">
                    <div class="identifier-status">
                        <span class="status-dot status-dot-green" aria-hidden="true"></span>
                        <span>Activos</span>
                        <strong>0</strong>
                    </div>
                </div>
                <div class="col-12 col-md-4">
                    <div class="identifier-status">
                        <span class="status-dot status-dot-yellow" aria-hidden="true"></span>
                        <span>Sin asignar</span>
                        <strong>0</strong>
                    </div>
                </div>
                <div class="col-12 col-md-4">
                    <div class="identifier-status">
                        <span class="status-dot status-dot-gray" aria-hidden="true"></span>
                        <span>Desactivados</span>
                        <strong>0</strong>
                    </div>
                </div>
            </div>

            <div class="empty-state">
                <div class="empty-state-icon" aria-hidden="true">🏷️</div>
                <h3 class="h5">Aún no tienes identificadores</h3>
                <p class="text-muted mb-0">Cuando registres y vincules un chip NFC a una mascota, aquí verás su estado y su última actividad.</p>
            </div>
        </section>

        <section id="estadisticas" class="dashboard-section mb-4" aria-labelledby="statistics-title">
            <div class="section-heading">
                <div>
                    <p class="dashboard-eyebrow mb-1">ACTIVIDAD Y REPORTES</p>
                    <h2 id="statistics-title" class="h3 mb-1">Estadísticas</h2>
                    <p class="text-muted mb-0">Un vistazo a la actividad de tus identificadores.</p>
                </div>
                <span class="section-icon" aria-hidden="true">📊</span>
            </div>

            <div class="row g-3 mt-2">
                <div class="col-12 col-lg-7">
                    <article class="statistics-card h-100">
                        <h3 class="h6">Escaneos por mes</h3>
                        <div class="chart-empty" role="status">
                            <span aria-hidden="true">📈</span>
                            <p class="mb-0">El gráfico aparecerá cuando tus identificadores registren escaneos.</p>
                        </div>
                    </article>
                </div>
                <div class="col-12 col-lg-5">
                    <article class="statistics-card h-100">
                        <h3 class="h6">Mascotas por tipo</h3>
                        <div class="chart-empty" role="status">
                            <span aria-hidden="true">🐶</span>
                            <p class="mb-0">Registra mascotas para consultar esta distribución.</p>
                        </div>
                    </article>
                </div>
            </div>
        </section>

        <section class="dashboard-section mb-4" aria-labelledby="activity-title">
            <div class="section-heading">
                <div>
                    <p class="dashboard-eyebrow mb-1">ÚLTIMOS MOVIMIENTOS</p>
                    <h2 id="activity-title" class="h3 mb-1">Actividad reciente</h2>
                    <p class="text-muted mb-0">Escaneos y actualizaciones de tus mascotas.</p>
                </div>
                <span class="section-icon" aria-hidden="true">🕘</span>
            </div>
            <div class="activity-empty mt-3">
                Aún no hay actividad para mostrar. Los eventos aparecerán cuando registres mascotas e identificadores.
            </div>
        </section>
    </main>

    <footer class="border-top mt-5 py-4 text-muted text-center">
        <div class="container">
            &copy; 2026 - PetID - Identificación Inteligente para Mascotas
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
