@model LoginViewModel
@{
    ViewData["Title"] = "Iniciar Sesión - PetID";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
</head>
<body>
    <div class="login-container">
        <div class="login-wrapper">
            <div class="login-card">
                <!-- Logo -->
                <div class="login-header text-center mb-4">
                    <img src="~/imagenes/Logo_PetID.png" alt="PetID Logo" class="login-logo" />
                    <h1 class="mt-3 fw-bold">PetID</h1>
                    <p class="text-muted small">Identificación Inteligente para Mascotas</p>
                </div>

                <!-- Form -->
                @if (TempData["RegistrationSuccess"] is string registrationSuccess)
                {
                    <div class="alert alert-success" role="status">@registrationSuccess</div>
                }

                <form method="post" class="login-form">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            @foreach (var modelState in ViewData.ModelState.Values)
                            {
                                @foreach (var error in modelState.Errors)
                                {
                                    <div>@error.ErrorMessage</div>
                                }
                            }
                        </div>
                    }

                    <!-- Email Input -->
                    <div class="mb-3">
                        <label for="email" class="form-label fw-bold">Correo Electrónico</label>
                        <div class="input-group">
                            <span class="input-group-text bg-transparent border-end-0">
                                <i class="bi bi-envelope"></i>
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-envelope" viewBox="0 0 16 16">
                                    <path d="M0 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2V8a1 1 0 0 1-1 1H1a1 1 0 0 1-1-1V4Zm14-1H2a1 1 0 0 0-1 1v.217l7 4.2 7-4.2V4a1 1 0 0 0-1-1Z"/>
                                    <path d="M16 12.5a3.5 3.5 0 1 1-7 0 3.5 3.5 0 0 1 7 0Zm-1.993-1.679a.5.5 0 0 0-.686.172l-1.335 2.226a.5.5 0 0 1-.814-.114l-.822-1.78a.5.5 0 0 0-.857.514l.822 1.78a1.5 1.5 0 0 0 2.431.34l1.335-2.226a.5.5 0 0 0-.172-.686Z"/>
                                </svg>
                            </span>
                            <input type="email" class="form-control border-start-0 bg-light" id="email" name="Email" placeholder="tu@email.com" required asp-for="Email" />
                        </div>
                    </div>

                    <!-- Password Input -->
                    <div class="mb-3">
                        <label for="password" class="form-label fw-bold">Contraseña</label>
                        <div class="input-group">
                            <span class="input-group-text bg-transparent border-end-0">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-lock" viewBox="0 0 16 16">
                                    <path d="M5.338 1.59a61.44 61.44 0 0 0-2.837.856.481.481 0 0 0-.328.39c-.554 4.157.726 7.19 2.253 9.188a10.725 10.725 0 0 0 2.287 2.233c.346.244.652.42.893.5.12.04.243.085.243.139 0 .013-.004.027-.016.044l.771 4.618a.75.75 0 0 0 .896.659l4.822-1.609a.75.75 0 0 0 .588-.849l-.213-2.557a.618.618 0 0 0 .27.339c1.527 2.128 2.807 5.231 2.253 9.188a.48.48 0 0 1-.328.39c-.651.213-1.75.56-2.837.856s-2.156.427-3.51.427-1.668-.213-2.337-.427c-.524-.17-1.065-.383-1.5-.589.343.59.904 1.086 1.5.589.435.206.976.419 1.5.589.669.214 1.156.427 2.337.427 1.354 0 2.719-.213 3.51-.427 1.087-.296 2.186-.643 2.837-.856a.48.48 0 0 0 .328-.39c.554-3.957-1.727-7.06-2.253-9.188a10.74 10.74 0 0 1-2.287-2.233c-.346-.244-.652-.42-.893-.5-.12-.04-.243-.085-.243-.139 0-.013.004-.027.016-.044l-.771-4.618a.75.75 0 0 1 .896-.659l4.822 1.609a.75.75 0 0 1 .588.849l-.213 2.557a.618.618 0 0 1-.27.339c-1.527-2.128-2.807-5.231-2.253-9.188a.48.48 0 0 0 .328-.39c.651-.213 1.75-.56 2.837-.856s2.156-.427 3.51-.427 1.668.213 2.337.427c.524.17 1.065.383 1.5.589-.343-.59-.904-1.086-1.5-.589-.435-.206-.976-.419-1.5-.589-.669-.214-1.156-.427-2.337-.427-1.354 0-2.719.213-3.51.427-1.087.296-2.186.643-2.837.856a.48.48 0 0 1-.328.39c-.554 3.957 1.727 7.06 2.253 9.188a10.74 10.74 0 0 0 2.287 2.233c.346.244.652.42.893.5.12.04.243.085.243.139 0 .013-.004.027-.016.044l.771 4.618a.75.75 0 0 0 .896.659l4.822-1.609a.75.75 0 0 0 .588-.849l-.213-2.557a.618.618 0 0 0 .27.339c1.527 2.128 2.807 5.231 2.253 9.188a.48.48 0 0 1-.328.39c-.651.213-1.75.56-2.837.856s-2.156.427-3.51.427-1.668-.213-2.337-.427c-.524-.17-1.065-.383-1.5-.589.343.59.904 1.086 1.5.589.435.206.976.419 1.5.589.669.214 1.156.427 2.337.427 1.354 0 2.719-.213 3.51-.427 1.087-.296 2.186-.643 2.837-.856a.48.48 0 0 0 .328-.39c.554-3.957-1.727-7.06-2.253-9.188a10.74 10.74 0 0 1-2.287-2.233c-.346-.244-.652-.42-.893-.5-.12-.04-.243-.085-.243-.139 0-.013.004-.027.016-.044l-.771-4.618a.75.75 0 0 1 .896-.659l4.822 1.609a.75.75 0 0 1 .588.849l-.213 2.557a.618.618 0 0 1-.27.339c-1.527-2.128-2.807-5.231-2.253-9.188a.48.48 0 0 0 .328-.39c.651-.213 1.75-.56 2.837-.856s2.156-.427 3.51-.427 1.668.213 2.337.427c.524.17 1.065.383 1.5.589-.343-.59-.904-1.086-1.5-.589-.435-.206-.976-.419-1.5-.589-.669-.214-1.156-.427-2.337-.427-1.354 0-2.719.213-3.51.427-1.087.296-2.186.643-2.837.856a.48.48 0 0 1-.328.39c-.554 3.957 1.727 7.06 2.253 9.188a10.74 10.74 0 0 0 2.287 2.233c.346.244.652.42.893.5.12.04.243.085.243.139 0 .013-.004.027.016.044l.771 4.618a.75.75 0 0 0 .896.659l4.822-1.609a.75.75 0 0 0 .588-.849l-.213-2.557a.618.618 0 0 0 .27.339c1.527 2.128 2.807 5.231 2.253 9.188a.48.48 0 0 1-.328.39c-.651.213-1.75.56-2.837.856s-2.156.427-3.51.427-1.668-.213-2.337-.427c-.524-.17-1.065-.383-1.5-.589.343.59.904 1.086 1.5.589.435.206.976.419 1.5.589.669.214 1.156.427 2.337.427 1.354 0 2.719-.213 3.51-.427 1.087-.296 2.186-.643 2.837-.856a.48.48 0 0 0 .328-.39c.554-3.957-1.727-7.06-2.253-9.188a10.74 10.74 0 0 1-2.287-2.233c-.346-.244-.652-.42-.893-.5-.12-.04-.243-.085-.243-.139 0-.013.004-.027.016-.044l-.771-4.618a.75.75 0 0 1 .896-.659l4.822 1.609a.75.75 0 0 1 .588.849l-.213 2.557a.618.618 0 0 1-.27.339c-1.527-2.128-2.807-5.231-2.253-9.188a.48.48 0 0 0 .328-.39c.651-.213 1.75-.56 2.837-.856s2.156.427 3.51.427 1.668.213 2.337.427c.524.17 1.065.383 1.5.589-.343-.59-.904-1.086-1.5-.589-.435-.206-.976-.419-1.5-.589-.669-.214-1.156-.427-2.337-.427-1.354 0-2.719.213-3.51.427-1.087.296-2.186.643-2.837.856a.48.48 0 0 1-.328.39c-.554 3.957 1.727 7.06 2.253 9.188a10.74 10.74 0 0 0 2.287 2.233c.346.244.652.42.893.5.12.04.243.085.243.139 0 .013-.004.027.016.044l.771 4.618a.75.75 0 0 0 .896.659l4.822-1.609a.75.75 0 0 0 .588-.849l-.213-2.557a.618.618 0 0 0 .27.339c1.527 2.128 2.807 5.231 2.253 9.188a.48.48 0 0 1-.328.39c-.651.213-1.75.56-2.837.856s-2.156.427-3.51.427-1.668-.213-2.337-.427c-.524-.17-1.065-.383-1.5-.589.343.59.904 1.086 1.5.589.435.206.976.419 1.5.589.669.214 1.156.427 2.337.427 1.354 0 2.719-.213 3.51-.427 1.087-.296 2.186-.643 2.837-.856a.48.48 0 0 0 .328-.39c.554-3.957-1.727-7.06-2.253-9.188a10.74 10.74 0 0 1-2.287-2.233c-.346-.244-.652-.42-.893-.5-.12-.04-.243-.085-.243-.139 0-.013.004-.027.016-.044l-.771-4.618a.75.75 0 0 1 .896-.659l4.822 1.609a.75.75 0 0 1 .588.849l-.213 2.557a.618.618 0 0 1-.27.339c-1.527-2.128-2.807-5.231-2.253-9.188a.48.48 0 0 0 .328-.39c.651-.213 1.75-.56 2.837-.856s2.156-.427 3.51-.427 1.668.213 2.337.427c.524.17 1.065.383 1.5.589-.343-.59-.904-1.086-1.5-.589-.435-.206-.976-.419-1.5-.589-.669-.214-1.156-.427-2.337-.427-1.354 0-2.719.213-3.51.427-1.087.296-2.186.643-2.837.856a.48.48 0 0 1-.328.39c-.554 3.957 1.727 7.06 2.253 9.188a10.74 10.74 0 0 0 2.287 2.233c.346.244.652.42.893.5.12.04.243.085.243.139 0 .013-.004.027.016.044l.771 4.618a.75.75 0 0 0 .896.659l4.822-1.609a.75.75 0 0 0 .588-.849l-.213-2.557a.618.618 0 0 0 .27.339c1.527 2.128 2.807 5.231 2.253 9.188a.48.48 0 0 1-.328.39c-.651.213-1.75.56-2.837.856s-2.156.427-3.51.427-1.668-.213-2.337-.427c-.524-.17-1.065-.383-1.5-.589.343.59.904 1.086 1.5.589.435.206.976.419 1.5.589.669.214 1.156.427 2.337.427 1.354 0 2.719-.213 3.51-.427 1.087-.296 2.186-.643 2.837-.856a.48.48 0 0 0 .328-.39c.554-3.957-1.727-7.06-2.253-9.188a10.74 10.74 0 0 1-2.287-2.233c-.346-.244-.652-.42-.893-.5-.12-.04-.243-.085-.243-.139 0-.013.004-.027.016-.044l-.771-4.618a.75.75 0 0 1 .896-.659l4.822 1.609a.75.75 0 0 1 .588.849l-.213 2.557a.618.618 0 0 1-.27.339c-1.527-2.128-2.807-5.231-2.253-9.188a.48.48 0 0 0 .328-.39c.651-.213 1.75-.56 2.837-.856s2.156-.427 3.51-.427 1.668.213 2.337.427c.524.17 1.065.383 1.5.589"/>
                                </svg>
                            </span>
                            <input type="password" class="form-control border-start-0 bg-light" id="password" name="Password" placeholder="Tu contraseña" required asp-for="Password" />
                        </div>
                    </div>

                    <!-- Remember Me -->
                    <div class="mb-3 form-check">
                        <input type="checkbox" class="form-check-input" id="rememberMe" name="RememberMe" asp-for="RememberMe" />
                        <label class="form-check-label" for="rememberMe">
                            Recuérdame en este dispositivo
                        </label>
                    </div>

                    <!-- Submit Button -->
                    <button type="submit" class="btn btn-primary w-100 py-2 fw-bold mb-3">Iniciar Sesión</button>

                    <!-- Divider -->
                    <div class="divider mb-3">
                        <span>O</span>
                    </div>

                    <!-- Social Buttons -->
                    <div class="d-grid gap-2">
                        <button type="button" class="btn btn-outline-secondary py-2">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-google me-2" viewBox="0 0 16 16">
                                <path d="M15.545 6.558a9.42 9.42 0 0 1 .139 1.626c0 2.434-.87 4.492-2.384 5.885h.002C11.978 15.292 10.158 16 8 16A8 8 0 1 1 8 0a7.689 7.689 0 0 1 5.352 2.082M8 1.707a6.292 6.292 0 0 0-6.292 6.292A6.292 6.292 0 0 0 8 14.292 6.292 6.292 0 0 0 14.292 8 6.292 6.292 0 0 0 8 1.707Z"/>
                            </svg>Continuar con Google
                        </button>
                    </div>
                </form>

                <!-- Sign Up Link -->
                <div class="text-center mt-4">
                    <p class="text-muted">
                        ¿No tienes cuenta? 
                        <a asp-action="Register" class="text-primary fw-bold text-decoration-none">Regístrate aquí</a>
                    </p>
                </div>

                <!-- Footer Links -->
                <div class="text-center mt-3 pt-3 border-top">
                    <small class="text-muted">
                        <a href="#" class="text-decoration-none text-muted">¿Olvidaste tu contraseña?</a>
                        &nbsp;|&nbsp;
                        <a href="/" class="text-decoration-none text-muted">Volver a inicio</a>
                    </small>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
